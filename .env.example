# Copy to .env (untracked) and adjust. Process environment variables override .env values.
# Read ONLY by task_factory/config.py. Empty values mean "use the default".

# --- Target repository (pinned; do not change without a team announcement) ---
CLICK_REPO_URL=https://github.com/pallets/click.git
CLICK_RELEASE_TAG=8.5.1
CLICK_BASE_COMMIT=cf19179e8e2fd54c601378cec9e0d21bb12b6fb1
PYTEST_PIN=9.0.2
UPSTREAM_CHANGES_PATH=artifacts/upstream/CHANGES.md

# --- LLM (Decision D1, provisional) ---
LLM_PROVIDER=google-genai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# live | record | replay  (replay needs no API key)
LLM_MODE=live
LLM_TEMPERATURE=0
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=3
LLM_MAX_PARALLEL=3
LLM_CACHE_DIR=artifacts/llm_cache

# --- Paths ---
ARTIFACTS_DIR=artifacts
CACHE_DIR=.cache
DB_PATH=artifacts/factory.db

# --- Stage 1 sandbox ---
SANDBOX_IMAGE_PREFIX=click-sandbox
SANDBOX_MAX_PARALLEL=3
SANDBOX_TIMEOUT_SEC=300
MAX_REPAIR_ATTEMPTS=3

# --- Stage 2 Harbor ---
HARBOR_BIN=harbor
HARBOR_TIMEOUT_SEC=900
HARBOR_MAX_PARALLEL=2

# --- Backend ---
# Comma-separated list
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
